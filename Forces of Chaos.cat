                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3755-fad0-6c0d-fe20" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="82e6-91c8-4f84-bd34" type="max"/>
              </constraints>
              <rules>
                <rule id="9973-e0d8-b201-cc9b" name="Bane Shield" publicationId="e8a8-d83e-c60c-3ad0" page="51" hidden="false">
                  <description>The Bane Shield is treated like normal shield. In addition, for each successful armour save in close combat, the shield inflicts a Strength 4 hit on the model that struck the blow.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="8090-5f2f-127d-f841" name="Magic Shield" hidden="false" targetId="4c58-0153-f37e-9905" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
