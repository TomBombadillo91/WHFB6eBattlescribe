      </constraints>
      <selectionEntries>
        <selectionEntry id="da94-26e6-078d-47d7" name="Unliving Idol" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="3566-ae1d-d87e-7ec0" value="0.0">
              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b31c-71fc-5da5-6700" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3566-ae1d-d87e-7ec0" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6189-8dd7-381d-62e3" type="max"/>
          </constraints>
          <rules>
            <rule id="2abd-5035-f02f-15b3" name="Unliving Idol" hidden="false">
              <description>The Daemon counts as a Beasts General when choosing the army.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="24f8-2fc2-9d15-8eb3" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2804-ca10-3b97-bc85" name="Radiance of Dark Glory" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0e66-f4e2-04d7-eafb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3f4e-0120-034b-6e72" type="max"/>
          </constraints>
          <rules>
            <rule id="947e-5112-86c6-e6d3" name="Radiance of Dark Glory" hidden="false">
              <description>The Daemon and any other Daemon units within 6&quot; suffer one less wound when defeated in combat. For example if a Daemon fails its instability test by 2, then it would only loses one wound.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="d1d9-ae90-622f-17b7" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b3b7-4445-3028-ba91" name="Chaos Disruption" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="48f1-1d90-35b9-7c19" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="db6a-54a5-6662-d433" type="max"/>
          </constraints>
          <rules>
            <rule id="8251-a834-4fef-f7fc" name="Chaos Disruption" hidden="false">
              <description>Any shooting at the Daemon or the unit it is with suffers an additional -1 to hit penalty.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="c7cb-884a-eb38-43ee" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="50.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b31c-71fc-5da5-6700" name="Master of Mortals" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="d45c-59de-3d90-8e15" value="0.0">
              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="da94-26e6-078d-47d7" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d45c-59de-3d90-8e15" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aae7-873d-bc28-b368" type="max"/>
          </constraints>
          <rules>
            <rule id="02b7-36fd-abce-dd45" name="Master of Mortals" hidden="false">
              <description>If the Daemon is the army General, Mortal units count as Core choices and Daemonic count as Special.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="ab8a-bf26-0f06-5208" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1595-d18a-c891-4b8b" name="Diabolic Splendour" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eba1-8eab-0555-27f2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="80b5-b44e-de70-d0b7" type="max"/>
          </constraints>
          <rules>
            <rule id="edc7-df98-19f5-d1d1" name="Diabolic Splendour" hidden="false">
              <description>The Daemonic Aura becomes a normal ward save so can be used against magical attacks. This is also conferred to any Daemon unit which he joins.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="73b1-54ee-5ec3-aa31" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8fb7-e078-b4e9-3a12" name="Soul Hunger" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed6f-a467-b113-c9e2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d820-3d3a-e633-1e53" type="max"/>
          </constraints>
          <rules>
            <rule id="b3a2-331d-de24-24fe" name="Soul Hunger" hidden="false">
              <description>Re-roll missed close combat attacks in the first round of any combat.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="1624-24c0-7acf-e4bd" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1018-f71f-d0a2-152b" name="Blade of the Ether" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cb8a-a0e1-00c0-fce1" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3dac-c20a-4349-baa2" type="max"/>
          </constraints>
          <rules>
            <rule id="c79c-91e2-b8f0-7ba8" name="Blade of the Ether" hidden="false">
              <description>The Daemon wields a hell-forged weapon that exists partly in another dimension, by passing armour.

The Daemons close combat attacks ignore armour saves.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="c2b7-34ad-798d-bbd3" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="45.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d2e8-ceb6-5abb-c4fa" name="Collar of Khorne" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b901-28a6-ed61-a2be" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0dc1-e644-5605-f6a8" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0de3-e9ea-a1ca-e813" type="max"/>
          </constraints>
          <rules>
            <rule id="31ec-a238-dfa4-1833" name="Collar of Khorne" hidden="false">
              <description>The Daemon wears a heavy studded collar as a mark of Khorne&apos;s protection again magic.

The Daemon has Magic Resistance (2).</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="ca84-ed26-a7c1-5f79" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6ace-f10e-d401-d485" name="Power Vortex" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="19d9-f7ab-4148-310e" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5f44-6d31-7b2d-ec6b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c1e9-054f-c861-a78d" type="max"/>
          </constraints>
          <rules>
            <rule id="3ecf-9068-2524-f2a3" name="Power Vortex" hidden="false">
              <description>At any point during the Chaos Magic phase, the Daemon may give up Wounds to generate Power dice (with no saves of any kind allowed, no Ward saves, no Regeneration, etc). For each Wound sacrificed, the Daemon generate an extra D3 Power dice that turn which only it may use.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="936e-01cf-9503-1c7d" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="365a-09bc-8f9d-c53a" name="Plague Flail" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8c83-a348-a664-eebe" type="equalTo"/>
              </conditions>
