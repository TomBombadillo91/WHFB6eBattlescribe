            <modifier type="remove" field="category" value="4a3f-84d1-0495-6ecb"/>
          </modifiers>
        </modifierGroup>
      </modifierGroups>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="3259-b8a4-87dd-c14e" type="max"/>
      </constraints>
      <rules>
        <rule id="af40-aa88-0572-cd10" name="Slashing Attack" hidden="false">
          <description>In any Chaos turn where the Chaos player hasn&apos;t declared a charge with them, Screamers can attack an enemy unit which is not inside a wood or a building by moving over it during the Remaining Moves part of their Movement phase. This inflicts an automatic Strength 3 hit per Screamer and the enemy cannot fight back — these hits count as missile hits and may force a Panic test. A Screamers unit may only use this special attack against one enemy unit per turn, even if they fly over more than one unit in that Movement phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="340f-f7ec-b5a9-075b" name="Daemonic" hidden="false" targetId="1d2a-5ef7-5722-e7d5" type="infoGroup"/>
        <infoLink id="ea81-523d-2afb-398a" name="Fly" hidden="false" targetId="87db-2d4c-3fa6-6a26" type="rule"/>
      </infoLinks>
      <categoryLinks>
