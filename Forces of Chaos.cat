      <rules>
        <rule id="0a2e-070e-8be5-dda8" name="Armour of Khorne" hidden="false">
          <description>The Daemon wears armour fashioned from materials unknown to mortals.

The Daemon has an armour save of 4+ in addition to its Daemonic Aura.</description>
        </rule>
      </rules>
