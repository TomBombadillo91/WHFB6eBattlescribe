              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1018-f71f-d0a2-152b" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
