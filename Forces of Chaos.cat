      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="5873-f566-82c4-ad22" name="Screamers" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="3.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b8ce-e929-a8a9-51b2" type="min"/>
            <constraint field="selections" scope="parent" value="20.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9880-03ce-3486-ba80" type="max"/>
          </constraints>
          <profiles>
            <profile id="6bf8-f27d-43de-6f29" name="Screamer" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">1</characteristic>
                <characteristic name="WS" typeId="d46f-1ae5-387f-4ac3">3</characteristic>
                <characteristic name="BS" typeId="22c7-799b-e07c-f32c">0</characteristic>
