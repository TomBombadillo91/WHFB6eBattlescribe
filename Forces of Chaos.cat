          <rules>
            <rule id="2e1a-1b1f-f2b6-b5e1" name="Scaly Skin (3+)" hidden="false"/>
            <rule id="fc64-101f-c983-fdd9" name="Two Breath Weapons" hidden="false">
              <description>Chaos Dragons have two different Breath Weapons. A chaos Dragon may use both breath weapons in the same turn. Each turn, one head breathes fire, which is Strength 4 and the other breathes a cloud of corrosive gas, resolved at Strength 2 with a -3 to Armour saves.</description>
            </rule>
          </rules>
