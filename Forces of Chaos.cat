              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a563-464b-eae9-cee3" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0595-7e8a-f89f-2604" type="max"/>
              </constraints>
              <rules>
                <rule id="5fc7-0687-b08a-664a" name="Chaos Runeshield" publicationId="e8a8-d83e-c60c-3ad0" page="51" hidden="false">
                  <description>The Chaos Runeshield is treated like a normal shield. It also negates the power of any magic weapons carried by models in base contact - treat them as ordinary non-magical weapons of their type.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="ce33-2608-4a24-e78f" name="Magic Shield" hidden="false" targetId="4c58-0153-f37e-9905" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="50.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8e26-8f26-e479-3305" name="Bane Shield" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4c3c-1abc-5f52-c225" type="instanceOf"/>
                        <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1d0e-264e-202e-4c42" type="instanceOf"/>
                        <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1db4-7ac0-050f-d454" type="instanceOf"/>
                        <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c6de-d7dc-79ae-a5b8" type="instanceOf"/>
