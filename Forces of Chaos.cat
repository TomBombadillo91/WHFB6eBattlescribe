      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="5b77-498e-02ec-f92a" name="Spawn of Chaos" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4fe1-b6f9-c29a-6fd7" type="min"/>
            <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ffe-2bd7-ee86-f65a" type="max"/>
          </constraints>
          <profiles>
            <profile id="2d7f-21d2-2003-8e6d" name="Spawn" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
              <modifiers>
                <modifier type="set" field="da3c-fb2b-4c5f-a22b" value="3D6">
                  <conditions>
                    <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="60d4-43fd-739e-a8c5" type="equalTo"/>
                  </conditions>
                </modifier>
                <modifier type="set" field="0c58-1252-962d-8fcc" value="5">
                  <conditions>
                    <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="180c-f2d6-6486-8946" type="equalTo"/>
                  </conditions>
                </modifier>
              </modifiers>
              <characteristics>
                <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">2D6</characteristic>
                <characteristic name="WS" typeId="d46f-1ae5-387f-4ac3">3</characteristic>
                <characteristic name="BS" typeId="22c7-799b-e07c-f32c">0</characteristic>
                <characteristic name="S" typeId="0c58-1252-962d-8fcc">4</characteristic>
                <characteristic name="T" typeId="16d7-9f22-06d8-8427">5</characteristic>
                <characteristic name="W" typeId="f9d0-a5b0-7e0b-a404">3</characteristic>
                <characteristic name="I" typeId="b418-0e30-644f-1435">2</characteristic>
                <characteristic name="A" typeId="fa03-f9a3-8117-98dd">D6+1</characteristic>
                <characteristic name="Ld" typeId="bbad-d421-400b-87c1">10</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="c44b-c698-e44c-9ed6" name="Unit Strength 3" hidden="false"/>
            <rule id="fe2d-8f26-87fc-2622" name="Special Movement" hidden="false">
              <description>Spawn of Chaos are moved in the Compulsory Movement part of the Chaos player&apos;s 
Movement phase, moving 2D6&quot; each turn. The player has no control over the distance moved, but must nominate in which direction the Spawn will move before rolling the dice (this must be in a straight line).

If the Spawn&apos;s movement is sufficient to take it into an enemy unit then it counts as charging, following all of the normal rules. The target may make a charge response as normal, counting the Movement value rolled as the Spawn&apos;s maximum charge distance (for the purposes of fleeing, standing and shooting, etc).</description>
            </rule>
            <rule id="bbfa-c6d3-a35f-f740" name="Special Attacks" hidden="false">
              <description>Models with this special rule have a random number of Attacks. Roll at the start of every Close Combat phase. Roll to hit and wound as normal.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="2694-8c38-9fc4-bfde" name="Unbreakable" hidden="false" targetId="f6c9-ac44-1d7c-ed6e" type="rule"/>
            <infoLink id="0186-120a-5c20-ce97" name="Fear" hidden="false" targetId="03be-3e56-1332-bf56" type="rule"/>
          </infoLinks>
          <selectionEntryGroups>
