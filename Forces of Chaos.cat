      <rules>
        <rule id="672e-a7a2-8756-d2e3" name="Tuskgor Charge" hidden="false">
          <description>A charging Tuskgor receives a Strength bonus of +2, giving it a Strength value of 5 during the turn in which it charges. Obviously this bonus applies to the Tuskgor and not to the Chariot or those riding in it.</description>
        </rule>
      </rules>
