            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="940b-043e-aadc-3efc" type="max"/>
          </constraints>
          <rules>
            <rule id="08d2-424a-8f08-916a" name="Plague Flail" hidden="false">
              <description>The Daemon&apos;s attacks count as Poisoned Attacks. This gift cannot be combined with a Blade of the Ether gift.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="d89b-890b-8b61-b00b" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="15.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="7c5b-8d29-a791-76fb" name="Gaze of Acquiescence" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="58f1-832c-9935-797b" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3310-791e-afc7-c0f4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0ccd-e348-ef2c-91b6" type="max"/>
          </constraints>
          <rules>
            <rule id="fa1a-5261-dc5a-46e2" name="Gaze of Acquiescence" hidden="false">
              <description>At the beginning of the Close Combat phase, select one model in base contact with the Daemon. The target must pass a Leadership test or may not make attacks in that Close Combat phase. Models Immune to Psychology cannot be affected.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="6e90-9f1f-7d32-a314" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6cc2-6138-4cf2-a899" name="Spell Breaker" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d9d2-eb60-46ec-825c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4a35-2b6c-1f92-42fa" type="max"/>
          </constraints>
          <rules>
            <rule id="1f6b-355e-2660-267b" name="Spell Breaker" hidden="false">
              <description>Once per battle the Daemon may dispel one enemy spell, except one which has just been cast with Irresistible Force.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="9d21-4d7d-2070-c229" name="Daemonic Gift" hidden="false" targetId="d855-0137-fb0f-b91c" primary="false"/>
