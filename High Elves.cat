        <entryLink id="a57e-0261-cce1-5c0b" name="Arcane Items" hidden="false" collective="false" import="true" targetId="da12-69cb-d15e-5b08" type="selectionEntryGroup">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="daeb-6ab0-83b2-8bf3" type="equalTo"/>
              </conditions>
