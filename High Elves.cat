          <selectionEntries>
            <selectionEntry id="8471-ee65-a1a4-cc10" name="Dragonscale Shield" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="f640-265e-682f-94f3" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="173e-60eb-bbba-5a9a" type="max"/>
              </constraints>
              <rules>
                <rule id="0b14-8ea6-73fa-5ec0" name="Dragonscale Shield" hidden="false">
                  <description>This shield confers a 5+ armour save which can be combined with other equipment normally. Also gives the bearer a 6+ Ward save.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="7072-4899-f3b5-e638" name="Magic Shield" hidden="false" targetId="4c58-0153-f37e-9905" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
              </costs>
            </selectionEntry>
