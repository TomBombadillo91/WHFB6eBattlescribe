          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f04f-dacc-b796-8db8" name="Guardian Phoenix" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="912c-e449-4156-d005" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1603-ac82-f23c-9f17" type="max"/>
          </constraints>
          <rules>
            <rule id="3bbd-bfd5-f039-f6f9" name="Guardian Phoenix" hidden="false">
              <description>Gives the wearer a 5+ Ward save.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="46a7-05dd-dd87-213d" name="Talisman" hidden="false" targetId="d777-f2f1-e0db-8e8e" primary="false"/>
