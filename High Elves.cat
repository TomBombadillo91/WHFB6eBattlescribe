              </costs>
            </selectionEntry>
            <selectionEntry id="318c-8a2c-403b-4420" name="Silver Wand" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="f3a6-32a0-fb97-80d4" type="max"/>
