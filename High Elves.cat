            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="930a-865c-c898-c1ca" type="max"/>
          </constraints>
          <rules>
            <rule id="e079-0f2f-de88-9503" name="Blade of Leaping Gold" hidden="false">
              <description>The blade confers +3 Attacks on the character wielding it.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="cf87-7a30-cc02-0fa2" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="60.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="eafe-f1b2-6057-b17d" name="Foe Bane" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="e6fa-11ab-7168-1e46" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8d40-76f0-92e4-a7bc" type="max"/>
          </constraints>
          <rules>
            <rule id="61a4-5d13-5034-a8b0" name="Foe Bane" hidden="false">
              <description>All hits on a target with 3 or more Wounds on its starting profile will always wound on a 2+. Armour saves are modified by the Strength of the bearer.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="02ef-9ea8-eecf-5e15" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2980-dfd2-cfc8-953a" name="Blade of Sea Gold" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48f1-4778-a9db-cde7" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="45ad-c1c0-0c8f-b934" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4003-a79c-4861-1506" type="max"/>
          </constraints>
          <rules>
            <rule id="d713-c1d6-4fd3-f6bd" name="Blade of Sea Gold" hidden="false">
              <description>No armour saves may be taken against wounds caused by this weapon.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="c048-9533-002a-b1b8" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0788-3dd8-aeac-3061" name="Reaver Bow" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48f1-4778-a9db-cde7" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="3b0b-4c17-57b5-7d37" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9e31-e5c5-40c9-198d" type="max"/>
          </constraints>
          <rules>
            <rule id="2696-0ccc-52b4-f6d6" name="Reaver Bow" hidden="false">
              <description>Treat the Reaver Bow as a normal longbow with the following exceptions: the bearer may shoot three times in each of his Shooting phases and any hits are resolved at Strength 5.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="77de-2084-096d-ac13" name="Blade of Darting Steel" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48f1-4778-a9db-cde7" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="281d-9fc9-fdcc-a2bf" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c473-09a3-9b7f-81bf" type="max"/>
          </constraints>
          <rules>
            <rule id="4bee-6b2d-0ddd-42f3" name="Blade of Darting Steel" hidden="false">
              <description>The wielder always strikes first, even if his opponent charged that turn. If both models have this ability, roll off to see who strikes first in each Close Combat phase. In addition, the wielder adds +1 to his rolls to hit.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="fa0e-d0bf-f2ba-c9ee" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="45.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b29c-8b19-6345-4ae3" name="Sword of Hoeth" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="623e-5f3d-d939-9b51" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="f68e-3a52-5b46-25b9" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a5fb-32d8-c3da-9fa7" type="max"/>
          </constraints>
          <rules>
            <rule id="c4ec-b7ec-00db-6291" name="Sword of Hoeth" hidden="false">
              <description>All hits wound automatically. Armour saves are modified by the Strength of the bearer.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="a627-b295-57df-f949" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="60.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b1da-c176-9bde-af73" name="Bow of the Seafarer" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="623e-5f3d-d939-9b51" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="5917-38cf-37d7-379f" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ebc8-3eb0-7899-0abc" type="max"/>
          </constraints>
          <rules>
            <rule id="675e-d0c1-2293-a7fe" name="Bow of the Seafarer" hidden="false">
              <description>Treat the Bow of the Seafarer as a normal longbow with the following exception. Resolve a hit from this like a single bolt from a Bolt Thrower. Note that you may stand &amp; shoot with the Bow of the Seafarer.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="60.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9ca2-2ae9-6733-a8c7" name="Fusil of Conflagration" publicationId="2c29-8521-dcc7-5337" page="11" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48f1-4778-a9db-cde7" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1ca8-b1ab-7187-2d49" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="29b3-f32f-761a-4c8b" type="max"/>
          </constraints>
          <rules>
            <rule id="0b6c-29a9-ac46-35d4" name="Fusil of Conflagration" publicationId="2c29-8521-dcc7-5337" page="11" hidden="false">
              <description>The bearer of the Fusil counts as having a breath attack, which hits at Strength 3. This is a flaming attack.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="e3b8-29a9-b4a0-2b38" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="de41-adde-b43f-dc77" name="Claw of Devastation" publicationId="2c29-8521-dcc7-5337" page="11" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="623e-5f3d-d939-9b51" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e397-7f46-389d-a1e9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="6e00-26b9-af80-05d3" type="max"/>
          </constraints>
          <rules>
            <rule id="a548-1d87-f518-6dbd" name="Claw of Devastation" publicationId="2c29-8521-dcc7-5337" page="11" hidden="false">
              <description>Shaped like a wickedly taloned claw, this magic weapon pulses with dark power, ripping apart armour and bone with equal ease.

The wielder may re-roll failed rolls to wound in close combat, and ignores Armour saves.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="e0d3-2292-ca5c-f482" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="80.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
