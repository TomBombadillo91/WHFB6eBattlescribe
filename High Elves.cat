          <rules>
            <rule id="e797-8d1d-04c0-fce2" name="Vambraces of Defence" hidden="false">
              <description>Gives the wearer a 4+ Ward save. In addition, the wearer may re-roll failed armour saves.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="c5d8-2387-7369-457a" name="Talisman" hidden="false" targetId="d777-f2f1-e0db-8e8e" primary="false"/>
