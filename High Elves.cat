        <selectionEntry id="d1b9-8d57-db8b-996e" name="Dragon" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="623e-5f3d-d939-9b51" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule id="fbfd-7f10-de6d-575b" name="Breathe Fire" hidden="false">
              <description>In battle it is used as any other Breath Weapon. Those hit by it suffer a Strength 4 hit. In addition, a unit that suffers casualties from Dragon&apos;s breath must take an immediate Panic test.</description>
            </rule>
            <rule id="1cea-afe6-f8af-5ecc" name="Scaly Skin (3+)" hidden="false"/>
          </rules>
          <infoLinks>
