              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="10.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="bad1-10b0-b865-eb15" name="Power Stone" hidden="false" collective="false" import="true" type="upgrade">
