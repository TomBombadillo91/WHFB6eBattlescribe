          </constraints>
          <rules>
            <rule id="e068-6fa5-61bb-3d6d" name="Virtue of Purity" hidden="false">
              <description>The Knight will always start the game with the Blessing of the Lady, even if the army did not pray. In addition, the Ward save which the Knight gains from the Blessing is always 5+. regardless of the Strength of the attack.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="6f82-fe5b-7a08-e523" name="Virtue of Purity" hidden="false" targetId="0dae-bfd2-f3f8-2e3a" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
