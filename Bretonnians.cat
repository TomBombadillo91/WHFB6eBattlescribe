      </constraints>
      <rules>
        <rule id="b753-2e5d-cff4-a4cb" name="Flying Cavalry" hidden="false">
          <description>- Flying Cavalry are Unit Strength 2.
- They receive +1 to their Armour save for being mounted.
- They are affected by spells, etc, that would affect cavalry.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c5b0-e8cd-cb1b-8139" name="Fly" hidden="false" targetId="87db-2d4c-3fa6-6a26" type="rule"/>
