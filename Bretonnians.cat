          </constraints>
          <rules>
            <rule id="0b37-3c86-2007-e521" name="Virtue of the Penitent" hidden="false">
              <description>The Knight is Stubborn, though he may never join any friendly units. He may not take any magic items, nor may he ride a Hippogryph or a Royal Pegasus.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="f4b5-95b4-7cdf-f032" name="Virtue of the Penitent" hidden="false" targetId="f6b7-151f-9165-3c8b" primary="false"/>
