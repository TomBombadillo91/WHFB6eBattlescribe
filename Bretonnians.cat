          </constraints>
          <rules>
            <rule id="d41d-591e-1b48-2d23" name="Virtue of Noble Disdain" hidden="false">
              <description>The Knight hates all enemies using missile weapons including war machine crews. In addition, any unit the Knight has joined never takes Panic tests caused by suffering 25% casualties (eg, shooting, magic, etc).</description>
            </rule>
          </rules>
          <categoryLinks>
