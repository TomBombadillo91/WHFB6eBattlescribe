          </constraints>
          <rules>
            <rule id="52b0-351f-7b63-f5f8" name="Virtue of Heroism" hidden="false">
              <description>Against Large Targets, and if armed with a non-magical weapon, the Knight has the Killing Blow special ability. This overrides the normal limitation of Killing Blow only affecting man-sized models.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="03ce-a128-d334-04c5" name="Virtue of Heroism" hidden="false" targetId="a423-3873-857e-12bb" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="80.0"/>
          </costs>
        </selectionEntry>
