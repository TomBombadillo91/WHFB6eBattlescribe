    <selectionEntry id="2b72-8cdd-6a55-de4b" name="Knights Errant" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="c5e1-8c49-cc69-3f08" name="Impetuous" hidden="false">
          <description>After charges have been declared, if any Impetuous units did not declare a charge but are within charge range of an enemy, then they must take a Leadership test to restrain themselves from charging. If this test is failed, they are forced to charge. If the test is passed, they may move normally.

In addition, so reckless are the Knights Errant, that whenever they charge, the unit and any characters that have joined them are Immune to Psychology for the rest of that turn.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="fa56-d30f-e809-cd13" name="Core" hidden="false" targetId="62d3-efc6-6c2c-634e" primary="true"/>
