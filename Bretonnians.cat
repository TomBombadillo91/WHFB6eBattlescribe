          </constraints>
          <rules>
            <rule id="0d86-ada4-31a1-f923" name="Virtue of Empathy" hidden="false">
              <description>The Knight may be fielded on foot. In addition, if he is not the army&apos;s General, Peasant units within 12&quot; of him may use his Leadership, rather than the normal distance of 6&quot;.</description>
            </rule>
          </rules>
          <categoryLinks>
