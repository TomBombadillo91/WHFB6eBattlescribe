          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="61bc-3c28-0bf0-c33f" type="max"/>
          </constraints>
          <rules>
            <rule id="e8dc-aa1f-f8f0-0114" name="Virtue of Purity" hidden="false">
              <description>The Knight will always start the game with the Blessing of the Lady, even if the army did not pray. In addition, the Ward save which the Knight gains from the Blessing is always 5+. regardless of the Strength of the attack.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="85f8-c3ef-46f2-cffa" name="Virtue of Purity" hidden="false" targetId="0dae-bfd2-f3f8-2e3a" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="23b8-da8c-1d06-8332" name="Virtue of Heroism" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
