                            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c40e-92ec-95c9-2fb4" type="equalTo"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </conditionGroup>
                  </conditionGroups>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8869-1eae-ad48-cfc1" type="max"/>
          </constraints>
          <rules>
            <rule id="1451-7a04-c931-5c1b" name="Virtue of the Impetuous Knight" hidden="false">
              <description>&apos;In the glory of the charge was Balduffi most alive, and though others more tempered by the fires of war better controlled their ardour, be was ever in the forefront of battle.&apos;

The Knight, and any mounted unit he is with, adds +D6&quot; for the first charge that they declare (roll after declaring the charge). If the charge is failed the unit will not add the extra D6&quot; to their failed charge movement.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="5ca2-ad89-8782-9354" name="Virtue of the Impetuous Knight" hidden="false" targetId="c40e-92ec-95c9-2fb4" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="70.0"/>
          </costs>
        </selectionEntry>
