            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0b1b-1558-d207-deac" type="max"/>
          </constraints>
          <rules>
            <rule id="a8c3-1e66-eee6-a7f4" name="Virtue of the Ideal" hidden="false">
              <description>The Knight gains the following bonuses to his profile: +2 Weapon Skill, +1 Initiative, +1 Attack. He may not be the army&apos;s General (even if he has the highest Leadership) and any friendly unit (including other Knightly characters, or units using a Knight&apos;s Leadership) taking any form of Leadership test within 6&quot; of this model suffers a -1 penalty to their Leadership.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="17bb-73ab-9df9-8fe3" name="Virtue of the Ideal" hidden="false" targetId="9081-37c4-141d-49d5" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="70.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1879-ac27-8f13-44af" name="Virtue of the Impetuous Knight" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="623e-5f3d-d939-9b51" type="instanceOf"/>
