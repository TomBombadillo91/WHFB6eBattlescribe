          </constraints>
          <rules>
            <rule id="6c7d-aa95-cc79-7947" name="Virtue of Discipline" hidden="false">
              <description>The enemy never gets a +1 combat resolution bonus for outnumbering in any combat that the character is involved in. Note, however, that he and any unit he has joined will still flee automatically if beaten by a fear-causing enemy that outnumbers them, as per the normal rules.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="3e83-fc04-cf47-0a61" name="Virtue of Discipline" hidden="false" targetId="81e6-0a1a-58ed-060b" primary="false"/>
