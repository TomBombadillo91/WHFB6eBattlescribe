        <selectionEntry id="2535-aaaa-5a35-12f5" name="The Dolorous Blade" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed9f-812a-062b-a4f9" type="min"/>
