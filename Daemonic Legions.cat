    <selectionEntry id="8b53-022d-06e9-f832" name="Plaguebearers" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="df7a-a4b0-9c52-9a3d" type="equalTo"/>
