          </constraints>
          <rules>
            <rule id="d9e2-3a81-5dcd-b405" name="Soporific Musk" hidden="false">
              <description>Any model in base contact with one or more Daemons with Soporific Musk halve their WS and I (rounding up).</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
          </costs>
