          </constraints>
          <rules>
            <rule id="717f-5fe1-e281-7fca" name="Plague Flail" hidden="false">
              <description>The Daemon&apos;s attacks count as Poisoned Attacks. This gift cannot be combined with a Blade of the Ether gift.</description>
            </rule>
          </rules>
