      </constraints>
      <selectionEntries>
        <selectionEntry id="79b3-3b68-b48c-b3c2" name="Radiance of Dark Glory" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1bce-e4f1-92e4-d6db" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d79-0f18-f42d-96e9" type="max"/>
          </constraints>
          <rules>
            <rule id="40b8-18ac-455c-5371" name="Radiance of Dark Glory" hidden="false">
              <description>The Daemon and any other Daemon units within 6&quot; suffer one less wound when defeated in combat. For example if a Daemon fails its instability test by 2, then it would only loses one wound.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8fb9-92e9-a720-4e54" name="Blade of the Ether" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1bce-e4f1-92e4-d6db" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bce8-d72c-c95f-513c" type="max"/>
          </constraints>
          <rules>
            <rule id="92f2-0525-2776-9faa" name="Blade of the Ether" hidden="false">
              <description>The Daemon wields a hell-forged weapon that exists partly in another dimension, by passing armour.

The Daemons close combat attacks ignore armour saves.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="45.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="bcd3-784a-8734-0d39" name="Soul Hunger" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3875-1f1e-6bcc-3c88" type="max"/>
          </constraints>
          <rules>
            <rule id="ce04-f731-1393-0f03" name="Soul Hunger" hidden="false">
              <description>Re-roll missed close combat attacks in the first round of any combat.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="bf01-cd27-5e03-c128" name="Spell Breaker" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1da3-59b2-27dd-9fb7" type="max"/>
          </constraints>
          <rules>
            <rule id="be60-b971-8d3c-0a7e" name="Spell Breaker" hidden="false">
              <description>Once per battle the Daemon may dispel one enemy spell, except one which has just been cast with Irresistible Force.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
