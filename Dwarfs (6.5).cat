        <profile id="41f7-7894-ca9b-e708" name="Artillery Crew (3)" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">3</characteristic>
            <characteristic name="WS" typeId="d46f-1ae5-387f-4ac3">4</characteristic>
            <characteristic name="BS" typeId="22c7-799b-e07c-f32c">3</characteristic>
            <characteristic name="S" typeId="0c58-1252-962d-8fcc">3</characteristic>
            <characteristic name="T" typeId="16d7-9f22-06d8-8427">4</characteristic>
