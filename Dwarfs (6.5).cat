      </constraints>
      <rules>
        <rule id="687a-c0a3-2cae-f13b" name="Immune to Panic" hidden="false">
          <description>Longbeards automatically pass any Panic tests they have to take.</description>
        </rule>
        <rule id="33f9-3afd-0317-7d95" name="Old Grumblers" hidden="false">
          <description>Any Dwarf unit within 6&quot; of a unit of non-fleeing Longbeards may re-roll failed Panic tests.</description>
        </rule>
        <rule id="1e93-7d05-6ed3-1a86" name="Longbeard Allowance" hidden="false">
          <description>You cannot have more units of Longbeards than units of Warriors. A character with Royal Blood allows one extra unit of Longbeards, and Josef Bugman&apos;s Longbeard Rangers are also in addition.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="8ac3-27c9-f6cd-4155" name="Core" hidden="false" targetId="62d3-efc6-6c2c-634e" primary="true"/>
