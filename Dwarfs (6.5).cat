            <characteristic name="Ld" typeId="bbad-d421-400b-87c1">10</characteristic>
          </characteristics>
        </profile>
        <profile id="e5d6-b538-0608-0aae" name="Kraggi" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">3</characteristic>
