          </constraints>
          <rules>
            <rule id="a153-9332-009c-7de0" name="Blasting Charges" hidden="false">
              <description>May be used as a thrown weapon in a Stand &amp; Shoot reaction: one enemy unit charging the Miners takes D6 Flaming Strength 6 hits, allocated as shooting, with a nominal range of 4&quot;. One use only.</description>
            </rule>
          </rules>
