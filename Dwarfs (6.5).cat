    <selectionEntry id="6121-870c-ee5d-12d5" name="Thane" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="add" field="category" value="ddfb-16a7-20d6-838f">
          <conditions>
            <condition field="selections" scope="self" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="ee70-03fd-69a6-9bee" type="atLeast"/>
