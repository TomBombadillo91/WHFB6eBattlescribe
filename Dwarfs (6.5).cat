      </constraints>
      <rules>
        <rule id="a361-e5cb-4cc0-ee09" name="Rangers" hidden="false">
          <description>0-1. A single unit of Warriors, Quarrellers or Longbeards armed with great weapons may be upgraded to Rangers, gaining the Scout special rule. Warriors or Longbeards upgraded to Rangers may also take throwing axes (+1 point per model).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0178-ae53-943b-3b1c" name="Scouts" hidden="false" targetId="ec06-621f-83ae-fd4c" type="rule"/>
      </infoLinks>
      <costs>
        <cost name="pts" typeId="eaa7-6800-e651-8bea" value="0.0"/>
      </costs>
    </selectionEntry>
