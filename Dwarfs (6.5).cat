          </constraints>
          <rules>
            <rule id="db31-fbab-b9c9-6baf" name="Bugman&apos;s Tankard" hidden="false">
              <description>In the Dwarf Movement phase any model in the same unit as Bugman may drink from the Tankard and regain one lost wound; not possible if the unit is in close combat. A unit containing Bugman and his Tankard is immune to fear and terror.</description>
            </rule>
          </rules>
