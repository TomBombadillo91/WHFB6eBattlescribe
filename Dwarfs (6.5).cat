      <profiles>
        <profile id="a127-0b61-4cab-872e" name="Gyrocopter" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">-</characteristic>
            <characteristic name="WS" typeId="d46f-1ae5-387f-4ac3">4</characteristic>
