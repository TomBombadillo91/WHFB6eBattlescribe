    <selectionEntry id="0b82-ff96-db44-e5b9" name="Miners" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="0a90-a35a-3bf4-7633" name="Underground Advance" hidden="false">
          <description>Miners need not deploy. From turn two, at the start of every Dwarf turn roll a D6: they arrive on a 4+, +1 to the roll for each turn after the second (a roll of 1 always fails). In the Movement phase they arrive from any table edge, treated exactly like a unit that pursued an enemy off the table in the previous turn. If they never arrive, their points are not awarded to the opponent.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="7a0f-f3d4-c57a-d365" name="Special" hidden="false" targetId="4a3f-84d1-0495-6ecb" primary="true"/>
      </categoryLinks>
