            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fc3d-3565-c580-0b09" type="min"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="156f-0beb-babd-9b45" type="max"/>
          </constraints>
          <rules>
            <rule id="d395-06cd-335b-55e1" name="Axe of Grimnir" hidden="false">
              <description>Bears the Master Rune of Skalf Blackhammer, the Master Rune of Alaric the Mad and the Giantbane Master Rune. The Giantbane rune turns each wound inflicted by the axe into D3 wounds, or D6 wounds against Trolls and Giants.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1a7b-dbc3-d7eb-6e03" name="Master Rune of Skalf Blackhammer" hidden="false" targetId="56b6-ef62-252c-fd21" type="rule"/>
