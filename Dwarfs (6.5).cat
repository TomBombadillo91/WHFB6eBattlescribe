          <rules>
            <rule id="aabe-0526-2864-72dc" name="Klad Brakak" hidden="false">
              <description>No armour saves are allowed against Klad Brakak. If the target fails its ward save (or has none), any armour and shield it wears or carries are destroyed, including magical ones. Also bears the Rune of Fury (+1 Attack).</description>
            </rule>
