      </profiles>
      <rules>
        <rule id="7c9f-a6c3-5b04-6450" name="Thorek Ironbrow" hidden="false">
          <description>Takes up a Lord choice and one Hero choice. Fielded exactly as presented. His rune items, Anvil of Doom, Kraggi and two Anvil Guards are included in his cost.</description>
        </rule>
        <rule id="2837-02c8-5b89-a04e" name="Master of Ancient Lore" hidden="false">
          <description>Thorek strikes runes on the Anvil of Doom with Ancient Power on a roll of 3+.</description>
        </rule>
        <rule id="5592-1dd4-0db8-8f57" name="Assistant at the Forge" hidden="false">
          <description>Kraggi is treated as a unit Champion, fights with his forge tongs (a hand weapon) and wears a leather apron (light armour). While Kraggi is alive Thorek may re-roll a failed attempt to strike a rune on the Anvil of Doom. If this extra dice rolls a 1, subtract 1 from the roll on the Failed Rune table, treating a total of 0 as 1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="618f-a90f-054f-0f99" name="Rune Lore" hidden="false" targetId="a431-2cd4-cc10-850d" type="rule"/>
      </infoLinks>
