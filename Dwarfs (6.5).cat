                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4cc9-817c-d699-8c97" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="323c-2c4f-2be8-f00e" name="Steam Drill" hidden="false">
                      <description>A Miner unit using Underground Advance with a steam drill may re-roll its arrival dice each turn until it arrives. In close combat it needs two hands, strikes last and gives +3 Strength.</description>
