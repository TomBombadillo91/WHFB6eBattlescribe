<catalogue id="85d6-47cd-182e-d688" name="Dwarfs (6.5)" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="4ca8-2035-2f87-1bd7" gameSystemRevision="37" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <categoryEntries>
    <categoryEntry id="7a81-8182-80d4-1874" name="Engineering Rune" hidden="false">
      <rules>
        <rule id="bacd-31f0-5dfa-6123" name="Engineering Runes" hidden="false">
          <description>Dwarf Cannons, Grudge Throwers and Bolt Throwers may be inscribed with up to three engineering runes. The Organ Gun, Flame Cannon and Gyrocopter may not have engineering runes. A shot from a war machine inscribed with any engineering rune counts as a magical attack.</description>
        </rule>
      </rules>
    </categoryEntry>
