      <selectionEntries>
        <selectionEntry id="e207-0a3c-6748-c081" name="The Carstein Ring" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="72bd-3327-881f-a995" type="equalTo"/>
              </conditions>
