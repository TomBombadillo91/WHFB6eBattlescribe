                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="17cc-34a2-fdd6-cd43" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="9333-4f24-893e-023a" type="max"/>
              </constraints>
              <rules>
                <rule id="d6cf-fb69-c362-3356" name="The Flayed Hauberk" hidden="false">
                  <description>The design and dark red colour of this armour make the wearer disturbingly similar to a walking flayed body.

Can&apos;t be chosen by Necrarch or Lahmian Vampires. 1+ armour save. This cannot be improved by any means.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="5601-3284-92b5-2151" name="Magic Armour" hidden="false" targetId="2963-aff1-28ca-7634" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4335-9cb0-524d-fa96" name="Armour of Bone" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6c32-9294-5151-a85b" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="7763-b58b-7061-d153" type="max"/>
              </constraints>
              <rules>
                <rule id="7670-a388-70cb-e49c" name="Armour of Bone" hidden="false">
                  <description>Gives a 5+ armour save and may be combined with other equipment. A Wizard can wear this armour without losing his ability to cast spells. When the wearer fails his first armour save (or if he&apos;s wounded by an attack against which he cannot take an armour save at all), the armour crumbles to dust and is destroyed, but the wound is ignored.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="5a1f-285d-1482-372e" name="Magic Armour" hidden="false" targetId="2963-aff1-28ca-7634" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="eaa7-6800-e651-8bea" value="50.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
