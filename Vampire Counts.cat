          </constraints>
          <rules>
            <rule id="2039-bc69-a44e-a30b" name="Quickblood" hidden="false">
              <description>The Vampire has a Ward save of 5+.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4d10-b8ba-f798-c60f" name="Innocence Lost" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="2591-c193-875b-6280" type="notEqualTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4fde-bd44-4865-587c" type="max"/>
          </constraints>
          <rules>
            <rule id="0134-9e6f-4e0c-5f0f" name="Innocence Lost" hidden="false">
              <description>The Vampire always attacks first in close combat, even if charged. If an enemy has the same power because of a magic item or spell, hits are resolved in order of Initiative. If the Vampire and her enemy have the same Initiative, roll a dice to decide who attacks first.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b479-4c98-680f-9a84" name="Transfix" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
