          </constraints>
          <rules>
            <rule id="9392-5ec9-6114-4165" name="Sword of the Kings" hidden="false">
              <description>Wight Lords only. This sword scores a Killing Blow on the result of a 5+.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="33d1-f496-8939-c1c6" name="Magic Weapon" hidden="false" targetId="e6e5-cff5-9987-d563" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
