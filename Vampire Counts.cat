        <profile id="8174-de7a-6add-245b" name="Wraith" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">-</characteristic>
