        <profile id="1177-1d9f-e8e2-5f61" name="Nightmares (2)" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="da3c-fb2b-4c5f-a22b">8</characteristic>
            <characteristic name="WS" typeId="d46f-1ae5-387f-4ac3">2</characteristic>
            <characteristic name="BS" typeId="22c7-799b-e07c-f32c">-</characteristic>
            <characteristic name="S" typeId="0c58-1252-962d-8fcc">3</characteristic>
            <characteristic name="T" typeId="16d7-9f22-06d8-8427">-</characteristic>
            <characteristic name="W" typeId="f9d0-a5b0-7e0b-a404">-</characteristic>
