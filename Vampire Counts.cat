    <selectionEntry id="c621-e2ba-f894-4794" name="Ghouls" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="9194-1e89-008b-443b" name="Scavengers" hidden="false">
          <description>Ghouls fight in undisciplined packs and have no hierarchy save the rule of the strongest. To represent this, Ghouls are skirmishers and cannot be joined by characters.</description>
