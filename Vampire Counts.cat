        </profile>
      </profiles>
      <rules>
        <rule id="ead5-2a22-d755-60b8" name="Ward Save (5+)" hidden="false">
          <description>This model has a 5+ Ward Save.</description>
        </rule>
        <rule id="c048-e5b8-4fa8-9bf4" name="Evocation of Death" hidden="false">
          <description>For every wound the Black Coach causes in close combat, it gains one extra wound immediately. This can restore a lost Wound and can even bring the Coach&apos;s total Wounds above the starting number. Fleeing units run down by the Coach de not count because not all enemies in the unit are actually killed; most of them scatter and escape the battlefield. When the Coach reaches a total of 10 more Wounds it will count as a scythed chariot, inflicting D6+1 impact hits. This effect lasts only as long as chariot has 10 or more Wounds.</description>
        </rule>
        <rule id="9ae8-dd7c-d59a-d3bb" name="Unit Strength 5" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="03f8-c2f3-d580-e863" name="Undead" hidden="false" targetId="5b4f-43ba-65c7-9bd2" type="infoGroup"/>
        <infoLink id="3099-f31f-937c-9872" name="Terror" hidden="false" targetId="3767-0d81-4db9-cda7" type="rule"/>
