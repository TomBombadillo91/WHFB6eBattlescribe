            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="14ba-4e4f-8123-f924" type="max"/>
          </constraints>
          <rules>
            <rule id="8217-7e6f-8f13-bc2c" name="Icon of Rulership" hidden="false">
              <description>Character in chariot only. May be taken in addition to another item in the Enchanted Items list. The character&apos;s chariot has +1 Unit Strength (so will be worth a total Unit Strength of 5).</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="4dee-a18a-fca6-7a42" name="Enchanted Item" hidden="false" targetId="d8eb-f296-d241-3c6d" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
