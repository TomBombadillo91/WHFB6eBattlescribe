      <selectionEntries>
        <selectionEntry id="c0b4-c32e-8b9b-69e1" name="Neferra&apos;s Plaques of Mighty Incantations" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8279-d207-5706-1272" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4983-d6eb-68e6-b1db" type="max"/>
          </constraints>
          <rules>
            <rule id="1efb-5299-75c5-ea19" name="Neferra&apos;s Plaques of Mighty Incantations" hidden="false">
              <description>The Priest may re-roll the dice rolled for any Incantation he&apos;s cast. Either all of the dice must be re-rolled or none.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="8040-d229-a60c-fa59" name="Arcane Item" hidden="false" targetId="7cfd-b676-48e1-6eec" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="30.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="874b-6c19-fbe5-0be2" name="Staff of Mastery" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="29a8-ce15-ee9a-59a0" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4941-e853-b1a6-d344" type="max"/>
          </constraints>
          <rules>
            <rule id="49dd-c36c-3908-7350" name="Staff of Mastery" hidden="false">
              <description>The bearer adds +1 to the total rolled to determine the Power Level of his incantations.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="d68f-b2b9-f43e-9973" name="Arcane Item" hidden="false" targetId="7cfd-b676-48e1-6eec" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="40.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4ce5-aefa-16f7-8cf0" name="Hieratic Jar" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5f38-b627-2bc0-a36c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a209-adb1-505e-dc99" type="max"/>
          </constraints>
          <rules>
            <rule id="6e01-f9b6-2cff-c72a" name="Hieratic Jar" hidden="false">
              <description>One use only. The liche Priest may release the energy of the Hieratic Jar during any Magic phase, just after he has cast his normal incantations). The Jar allows him to use an extra incantation that phase.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="8b57-38aa-b707-c6e7" name="Arcane Item" hidden="false" targetId="7cfd-b676-48e1-6eec" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8b03-1cfb-2832-e8cb" name="Enkhil&apos;s Kanopi" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1ae0-caa0-aa1f-ec71" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="71bc-e862-87db-bf81" type="max"/>
          </constraints>
          <rules>
            <rule id="0553-d4c9-4c8e-8604" name="Enkhil&apos;s Kanopi" hidden="false">
              <description>Bound Item, Power Level 4. If activated successfully, all Remains in Play spells on the tabletop are automatically dispelled.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="1539-2ff8-b99d-cc43" name="Arcane Item" hidden="false" targetId="7cfd-b676-48e1-6eec" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="20.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2768-13a8-2143-c985" name="Staff of Ravening" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a89c-49cd-ee30-9071" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="feba-69ad-b68f-5f26" type="max"/>
          </constraints>
          <rules>
            <rule id="eea7-5624-9080-9379" name="Staff of Ravening" hidden="false">
              <description>Bound Item, Power Level 4. This spell is a magic missile with 18&quot; range. The targeted unit suffers 3D6 Strength 2 hits.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="24e3-5d90-5454-f9c8" name="Arcane Item" hidden="false" targetId="7cfd-b676-48e1-6eec" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="45.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink id="809a-ae9e-cd54-3683" name="Staff of Sorcery" hidden="false" collective="false" import="true" targetId="0871-b449-88b1-0a33" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="62a7-e906-b842-bab6" type="max"/>
          </constraints>
        </entryLink>
        <entryLink id="bf54-4887-d85d-20fb" name="Power Stone" hidden="false" collective="false" import="true" targetId="2be9-2fdd-98db-e42c" type="selectionEntry"/>
