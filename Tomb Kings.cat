            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="761e-8860-1686-cbf5" type="max"/>
          </constraints>
          <rules>
            <rule id="39a2-e4d6-ac5f-adbf" name="Chariot of Fire" hidden="false">
              <description>Character in chariot only. The character&apos;s chariot does D6+1 impact hits, rather than D3. Impact hits from the Chariot of Fire count as both magical attacks and flaming attacks.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="0703-146d-cd96-9b76" name="Enchanted Item" hidden="false" targetId="d8eb-f296-d241-3c6d" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="25.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f062-467b-1cce-3b3e" name="Cloak of the Dunes" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="4247-6fcd-d7bd-3cab" value="0.0">
