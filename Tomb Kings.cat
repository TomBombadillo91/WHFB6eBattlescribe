    <selectionEntry id="9dbb-91c1-2ba3-17a7" name="Screaming Skull Catapult" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="275d-74b9-f174-296d" name="Crew (3)" hidden="false" typeId="0a0f-00cd-0261-c0ea" typeName="Model">
