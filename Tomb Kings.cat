        </selectionEntry>
        <selectionEntry id="2592-4ff7-2e45-7cb9" name="Death Mask of Kharnut" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1e07-37ce-cb34-3482" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8cf8-0828-79ab-3688" type="max"/>
          </constraints>
          <rules>
            <rule id="549e-8dc3-a1af-5a36" name="Death Mask of Kharnut" hidden="false">
              <description>A model wearing this mask causes terror.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="cd8a-825c-edb3-bbcc" name="Enchanted Item" hidden="false" targetId="d8eb-f296-d241-3c6d" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="35.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1215-6918-f045-315f" name="Chariot of Fire" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
