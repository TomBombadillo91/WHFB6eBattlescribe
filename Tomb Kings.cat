        </selectionEntry>
        <selectionEntry id="640a-1030-bdeb-59b1" name="Vambraces of the Sun" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8307-2e72-14d5-d701" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dc24-e8ec-4272-fe5d" type="max"/>
          </constraints>
          <rules>
            <rule id="3cbe-e87f-835b-9ea7" name="Vambraces of the Sun" hidden="false">
              <description>One model in base contact, chosen by the bearer, loses 1 Attack. Against mounted models, the Tomb Kings player must choose either the mount/monster or the rider. If the model has several types of attack, the Tomb Kings player chooses which type of attack is lost. This has no effect against foes which do not use their Attacks value in combat, such as Giants.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink id="9d42-762e-9d21-cc2c" name="Enchanted Item" hidden="false" targetId="d8eb-f296-d241-3c6d" primary="false"/>
          </categoryLinks>
          <costs>
            <cost name="pts" typeId="eaa7-6800-e651-8bea" value="15.0"/>
          </costs>
        </selectionEntry>
