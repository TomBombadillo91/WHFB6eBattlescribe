        </profile>
      </profiles>
      <rules>
        <rule id="a518-7bbc-a85d-d4ad" name="Unstoppable Assault" hidden="false">
          <description>For every wounding hit that the Bone Giant inflicts when it charges (before saving throws), the Bone Giant gets to make an additional attack. Such additional attacks also benefit from the Unstoppable Assault rule.</description>
        </rule>
      </rules>
